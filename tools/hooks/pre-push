#!/bin/sh
# furet pre-push hook: quality gates before pushing.
# Runs in order, stops at the first failure and propagates its exit code.
set -e

echo "pre-push: cargo fmt --check"
cargo fmt --check

echo "pre-push: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "pre-push: cargo test"
cargo test
