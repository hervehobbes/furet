# Line-ending normalization for a cross-platform (Windows-first) repo.
* text=auto

# Hook scripts must keep LF endings so Git's bundled sh can run them.
*.sh text eol=lf

# commit-msg runs under sh too: LF in the working copy, like the other hooks.
tools/hooks/commit-msg text eol=lf

# PowerShell sources are native to Windows.
*.ps1 text eol=crlf

# git-cliff --prepend finds the header only in an LF CHANGELOG.md.
CHANGELOG.md text eol=lf

# Binaries.
*.exe binary
*.pdb binary
*.png binary
